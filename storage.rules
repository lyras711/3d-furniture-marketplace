rules_version = '2';
// Catalogue GLBs and thumbnails are public; uploads happen only through the Admin SDK.
service firebase.storage {
  match /b/{bucket}/o {
    match /catalog/{allPaths=**} {
      allow read: if true;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
