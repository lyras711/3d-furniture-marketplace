{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/admin/**", "run": { "serviceId": "forma-admin-worker", "region": "europe-west1" } },
      { "source": "/api/worker/**", "run": { "serviceId": "forma-admin-worker", "region": "europe-west1" } },
      { "source": "/admin{,/**}", "destination": "/index.html" },
      { "source": "/planner{,/**}", "destination": "/index.html" },
      { "source": "/for-business{,/**}", "destination": "/index.html" },
      { "source": "/b2b{,/**}", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
