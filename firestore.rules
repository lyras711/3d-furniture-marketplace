rules_version = '2';
// Every collection is accessed only by the Formivo API (scripts/admin-server.ts) through the
// Admin SDK, which bypasses these rules. Browsers never read or write Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
